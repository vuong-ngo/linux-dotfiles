/*****----- Main Rofi Configuration (Soft & Gentle Frosted Glass) -----*****/
configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 10.5";
    show-icons:                 true;
    display-drun:               "󰀻  Apps";
    display-run:                "󰆍  Run";
    display-window:             "󰖯  Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Imports -----*****/
@import                         "~/.config/rofi/colors.rasi"
@import                         "~/.config/rofi/keybinds.rasi"

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      680px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     1.5px solid;
    border-radius:              18px;
    border-color:               @border-colour;
    background-color:           @background;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    14px;
    margin:                     0px;
    padding:                    22px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    11px 16px;
    border:                     1px solid;
    border-radius:              12px;
    border-color:               @border-subtle;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "󰍉 ";
    background-color:           transparent;
    text-color:                 @accent;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font 12";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search applications, commands, windows...";
    placeholder-color:          @foreground-muted;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    2;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    6px;
    margin:                     0px;
    padding:                    4px 0px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    8px 12px;
    border-radius:              10px;
    border:                     1px solid;
    border-color:               transparent;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element normal.normal, element alternate.normal {
    background-color:           transparent;
    text-color:                 @foreground;
    border-color:               transparent;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @selected-text;
    border-color:               @border-highlight;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       26px;
    cursor:                     inherit;
    vertical-align:             0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "JetBrainsMono Nerd Font 10.5";
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                    true;
    spacing:                    10px;
    margin:                     4px 0px 0px 0px;
    padding:                    0px;
    background-color:           transparent;
}

button {
    padding:                    8px 14px;
    border-radius:              10px;
    border:                     1px solid;
    border-color:               @border-subtle;
    background-color:           @background-alt;
    text-color:                 @foreground-muted;
    cursor:                     pointer;
    font:                       "JetBrainsMono Nerd Font 10";
}

button selected {
    background-color:           @selected;
    text-color:                 @selected-text;
    border-color:               @border-highlight;
}
