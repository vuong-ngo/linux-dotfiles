/*****----- Configuration for Minimalist Power Menu (SwayNC Architectural Style & Compact 10.5 Type) -----*****/
configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Global Properties -----*****/
@import                          "~/.config/rofi/global.rasi"

/*****----- Main Window (Floating Top Bar, Pure 0px Sharp Geometry) -----*****/
window {
    transparency:       "real";
    location:           north;
    anchor:             north;
    fullscreen:         false;
    width:              540px;
    x-offset:           0px;
    y-offset:           24px;

    border:             1px;
    border-radius:      0px;
    border-color:       @border-colour;
    background-color:   @background;
    padding:            14px;
    cursor:             "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:            true;
    spacing:            0px;
    margin:             0px;
    padding:            0px;
    background-color:   transparent;
    children:           [ "listview" ];
}

/*****----- Listview (6 Centered Icons) -----*****/
listview {
    enabled:            true;
    columns:            6;
    lines:              1;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;

    spacing:            8px;
    background-color:   transparent;
    text-color:         @foreground;
    cursor:             "default";
}

/*****----- Elements (SwayNC-styled Modular Icon Tiles) -----*****/
element {
    enabled:            true;
    padding:            14px 0px;
    border-radius:      0px;
    border:             1px 1px 1px 3px;
    border-color:       @border-subtle;
    background-color:   @background-card;
    text-color:         @foreground;
    cursor:             pointer;
}

element normal.normal, element alternate.normal {
    background-color:   @background-card;
    text-color:         @foreground;
    border:             1px 1px 1px 3px;
    border-color:       @border-subtle;
}

element selected.normal {
    background-color:   @selected;
    text-color:         @selected-text;
    border:             1px 1px 1px 4px;
    border-color:       @border-highlight;
}

element-text {
    font:               "JetBrainsMono Nerd Font Bold 22";
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
}
