/*****----- Configuration for Minimalist Power Menu (Graphite Dark Glass) -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                          "~/.config/rofi/colors.rasi"
@import                          "~/.config/rofi/keybinds.rasi"

/*****----- Main Window (Floating Top Bar) -----*****/
window {
    transparency:       "real";
    location:           north;
    anchor:             north;
    fullscreen:         false;
    width:              560px;
    x-offset:           0px;
    y-offset:           24px;

    border:             1.5px solid;
    border-radius:      20px;
    border-color:       @border-colour;
    background-color:   @background;
    padding:            12px;
    cursor:             "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:            true;
    spacing:            0px;
    margin:             0px;
    padding:            0px;
    background-color:   transparent;
    children:           [ "listview" ];
}

/*****----- Listview (6 Centered Icons) -----*****/
listview {
    enabled:            true;
    columns:            6;
    lines:              1;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;

    spacing:            10px;
    background-color:   transparent;
    text-color:         @foreground;
    cursor:             "default";
}

/*****----- Elements (Icon Tiles) -----*****/
element {
    enabled:            true;
    padding:            16px 0px;
    border-radius:      14px;
    border:             1px solid;
    border-color:       @border-subtle;
    background-color:   @background-alt;
    text-color:         @foreground;
    cursor:             pointer;
}

element normal.normal, element alternate.normal {
    background-color:   @background-alt;
    text-color:         @foreground;
    border-color:       @border-subtle;
}

element selected.normal {
    background-color:   @selected;
    text-color:         @selected-text;
    border-color:       @selected;
}

element-text {
    font:               "JetBrainsMono Nerd Font Bold 24";
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
}
