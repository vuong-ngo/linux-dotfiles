/*****----- NVIDIA Launcher Dedicated Rofi Theme (SwayNC Architectural Style & Compact 10.5 Type) -----*****/
configuration {
    modi:                       "drun";
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
    show-icons:                 true;
    display-drun:               "󰍛 NVIDIA GPU";
    drun-display-format:        "{name}";
}

/*****----- Imports -----*****/
@import                         "~/.config/rofi/global.rasi"

/*****----- Main Window (Pure 0px Sharp Geometry) -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      720px;

    border:                     1px;
    border-radius:              0px;
    border-color:               @border-colour;
    background-color:           @background;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    12px;
    padding:                    22px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

/*****----- Inputbar (SwayNC Modular Framed Container) -----*****/
inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 16px;
    border:                     1px;
    border-radius:              0px;
    border-color:               @border-subtle;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "󰍛 ";
    background-color:           transparent;
    text-color:                 @accent;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                " Launch app on discrete NVIDIA GPU";
    placeholder-color:          @foreground-muted;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    2;
    lines:                      6;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    7px;
    padding:                    4px 0px 0px 0px;
    background-color:           transparent;
    text-color:                 @foreground;
}

/*****----- Elements (SwayNC-styled Modular Cards with Accent Edge) -----*****/
element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    9px 12px;
    border-radius:              0px;
    border:                     1px 1px 1px 3px;
    border-color:               @border-subtle;
    background-color:           @background-card;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element normal.normal, element alternate.normal {
    background-color:           @background-card;
    text-color:                 @foreground;
    border:                     1px 1px 1px 3px;
    border-color:               @border-subtle;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @selected-text;
    border:                     1px 1px 1px 4px;
    border-color:               @border-highlight;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}
