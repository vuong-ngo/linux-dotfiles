/*****----- Configuration for Clipboard Manager (Bottom-Left Corner Floating, SwayNC Style & 10.5 Type) -----*****/
configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Global Properties -----*****/
@import                         "~/.config/rofi/global.rasi"

/*****----- Main Window (Floating Bottom-Left Corner with Offset) -----*****/
window {
    transparency:                "real";
    location:                    south west;
    anchor:                      south west;
    fullscreen:                  false;
    width:                       580px;
    x-offset:                    24px;
    y-offset:                    24px;

    enabled:                     true;
    margin:                      0px;
    padding:                     16px;
    border:                      1px;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar (SwayNC Modular Framed Container) -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px 14px;
    border-radius:               0px;
    border:                      1px;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
    font:                        "JetBrainsMono Nerd Font Bold 12";
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search clipboard history...";
    placeholder-color:           @foreground-muted;
    vertical-align:              0.5;
    font:                        "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Message Header (Shortcuts Info) -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     7px 12px;
    border-radius:               0px;
    border:                      1px;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground-muted;
}

textbox {
    font:                        "JetBrainsMono Nerd Font Bold 9.5";
    background-color:            transparent;
    text-color:                  @foreground-muted;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

/*****----- Listview (Elevated Card Layout) -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     7px;
    margin:                      2px 0px 0px 0px;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements (SwayNC-styled Modular Cards with Accent Edge) -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     9px 13px;
    border-radius:               0px;
    border:                      1px 1px 1px 3px;
    border-color:                @border-subtle;
    background-color:            @background-card;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            @background-card;
    text-color:                  @foreground;
    border:                      1px 1px 1px 3px;
    border-color:                @border-subtle;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
    border:                      1px 1px 1px 4px;
    border-color:                @border-highlight;
}

/* Distinct Red Warning Style for Clear All Button (Matches SwayNC Critical Notification) */
element normal.urgent, element alternate.urgent {
    background-color:            rgba(248, 113, 113, 0.12);
    text-color:                  @urgent;
    border:                      1px 1px 1px 3px;
    border-color:                @urgent;
}

element selected.urgent {
    background-color:            rgba(248, 113, 113, 0.28);
    text-color:                  #FFFFFF;
    border:                      1px 1px 1px 4px;
    border-color:                @urgent;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}
