/*****----- Configuration for Clipboard Manager (Graphite Dark Glass) -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                         "~/.config/rofi/colors.rasi"
@import                         "~/.config/rofi/keybinds.rasi"

/*****----- Main Window (Floating Bottom-Left) -----*****/
window {
    transparency:                "real";
    location:                    south west;
    anchor:                      south west;
    width:                       540px;
    x-offset:                    24px;
    y-offset:                    -24px;

    enabled:                     true;
    margin:                      0px;
    padding:                     14px;
    border:                      1.5px solid;
    border-radius:               18px;
    border-color:                @border-colour;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px 14px;
    border-radius:               12px;
    border:                      1px solid;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
    font:                        "JetBrainsMono Nerd Font Bold 12";
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search clipboard history...";
    placeholder-color:           @foreground-muted;
    vertical-align:              0.5;
    font:                        "JetBrainsMono Nerd Font 10.5";
}

/*****----- Message Header (Shortcuts Info) -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     6px 10px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground-muted;
}

textbox {
    font:                        "JetBrainsMono Nerd Font 9.5";
    background-color:            transparent;
    text-color:                  @foreground-muted;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     6px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     8px;
    margin:                      0px;
    padding:                     8px 12px;
    border-radius:               10px;
    border:                      1px solid;
    border-color:                transparent;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
    border-color:                transparent;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
    border-color:                @selected;
}

/* Distinct Red Warning Style for Clear All Button */
element normal.urgent, element alternate.urgent {
    background-color:            rgba(251, 113, 133, 0.12);
    text-color:                  @urgent;
    border-color:                rgba(251, 113, 133, 0.25);
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  #121214;
    border-color:                @urgent;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    font:                        "JetBrainsMono Nerd Font 10.5";
}
