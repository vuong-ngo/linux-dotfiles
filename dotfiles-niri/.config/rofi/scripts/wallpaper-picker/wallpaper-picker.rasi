/*****----- Configuration for Wallpaper Picker (Graphite Dark Glass) -----*****/
configuration {
    show-icons:                 true;
}

/*****----- Global Properties -----*****/
@import                         "~/.config/rofi/colors.rasi"
@import                         "~/.config/rofi/keybinds.rasi"

/*****----- Main Window (Bottom Center Compact Gallery) -----*****/
window {
    transparency:                "real";
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       1480px;
    height:                      320px;
    x-offset:                    0px;
    y-offset:                    -24px;

    enabled:                     true;
    border:                      1.5px solid;
    border-radius:               22px;
    border-color:                @border-colour;
    background-color:            @background;
    padding:                     16px;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "listview", "inputbar" ];
}

/*****----- Listview (Horizontal Gallery Row) -----*****/
listview {
    enabled:                     true;
    expand:                      false;
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     12px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements (Wallpaper Cards) -----*****/
element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     6px;
    margin:                      0px;
    padding:                     8px;
    border-radius:               14px;
    border:                      1px solid;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
    border-color:                @border-subtle;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
    border-color:                @selected;
}

element-icon {
    background-color:            transparent;
    size:                        175px;
    cursor:                      inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               10px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono Nerd Font Bold 10.5";
    horizontal-align:            0.5;
    vertical-align:              0.5;
}

/*****----- Inputbar (Bottom Filter Bar) -----*****/
inputbar {
    enabled:                     true;
    margin:                      0px;
    padding:                     10px 16px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    border:                      1px solid;
    border-color:                @border-subtle;
    border-radius:               14px;
    spacing:                     10px;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "󰍉 ";
    font:                        "JetBrainsMono Nerd Font Bold 13";
    background-color:            transparent;
    text-color:                  @accent;
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search wallpaper gallery...";
    placeholder-color:           @foreground-muted;
    vertical-align:              0.5;
    font:                        "JetBrainsMono Nerd Font 10.5";
}
