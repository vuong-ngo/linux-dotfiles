/*****----- Configuration for Wallpaper Picker (Inputbar on Top, Gallery Below, SwayNC Style) -----*****/
configuration {
    show-icons:                 true;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Global Properties -----*****/
@import                         "~/.config/rofi/global.rasi"

/*****----- Main Window (Floating Bottom Gallery, Pure 0px Sharp Geometry) -----*****/
window {
    transparency:                "real";
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       1440px;
    height:                      310px;
    x-offset:                    0px;
    y-offset:                    24px;

    enabled:                     true;
    border:                      1px;
    border-radius:               0px;
    border-color:                @border-colour;
    background-color:            @background;
    padding:                     14px;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar (On Top: SwayNC Modular Framed Container) -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 14px;
    border:                      1px;
    border-radius:               0px;
    border-color:                @border-subtle;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                     false;
    str:                        "󰸉 ";
    background-color:            transparent;
    text-color:                  @accent;
    vertical-align:              0.5;
    font:                        "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Filter wallpapers...";
    placeholder-color:           @foreground-muted;
    vertical-align:              0.5;
    font:                        "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Listview (Below: Horizontal Gallery Row) -----*****/
listview {
    enabled:                     true;
    expand:                      false;
    columns:                     6;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                  false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     12px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements (SwayNC-styled Modular Wallpaper Cards) -----*****/
element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     6px;
    margin:                      0px;
    padding:                     8px;
    border-radius:               0px;
    border:                      1px 1px 1px 3px;
    border-color:                @border-subtle;
    background-color:            @background-card;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            @background-card;
    text-color:                  @foreground;
    border:                      1px 1px 1px 3px;
    border-color:                @border-subtle;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @selected-text;
    border:                      1px 1px 1px 4px;
    border-color:                @border-highlight;
}

element-icon {
    background-color:            transparent;
    size:                        170px;
    cursor:                      inherit;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               0px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        "JetBrainsMono Nerd Font Bold 10.5";
    horizontal-align:            0.5;
}
