/*****----- Control Center Dedicated Rofi Theme (SwayNC Architectural Style & Compact 10.5 Type) -----*****/
configuration {
    show-icons:                 false;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Imports -----*****/
@import                         "~/.config/rofi/global.rasi"

/*****----- Main Window (Pure 0px Sharp Geometry) -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      640px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     1px;
    border-radius:              0px;
    border-color:               @border-colour;
    background-color:           @background;
    cursor:                     "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    20px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

/*****----- Inputbar (SwayNC Modular Framed Container) -----*****/
inputbar {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    10px 16px;
    border:                     1px;
    border-radius:              0px;
    border-color:               @border-subtle;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        " ";
    background-color:           transparent;
    text-color:                 @accent;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font Bold 12";
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @foreground;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      11;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;

    spacing:                    6px;
    margin:                     4px 0px 0px 0px;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

/*****----- Elements (SwayNC-styled Modular Cards with Accent Edge) -----*****/
element {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    9px 14px;
    border-radius:              0px;
    border:                     1px 1px 1px 3px;
    border-color:               @border-subtle;
    background-color:           @background-card;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element normal.normal, element alternate.normal {
    background-color:           @background-card;
    text-color:                 @foreground;
    border:                     1px 1px 1px 3px;
    border-color:               @border-subtle;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @selected-text;
    border:                     1px 1px 1px 4px;
    border-color:               @border-highlight;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    font:                       "JetBrainsMono Nerd Font Bold 10.5";
}
