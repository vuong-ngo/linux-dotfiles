/*****----- Colors - Universal Obsidian Frosted Glass (Soft & Gentle Palette) -----*****/
* {
    /* Pure Neutral Frosted Glass (Zero hue bias, softly diffuses any wallpaper background) */
    background:          rgba(16, 16, 20, 0.82); /* Frosted Obsidian Glass (82% opacity) */
    background-alt:      rgba(255, 255, 255, 0.04); /* Soft translucent inner container */
    background-card:     rgba(255, 255, 255, 0.06); /* Elevated frosted card */
    background-hover:    rgba(255, 255, 255, 0.08); /* Gentle hover sheen */

    /* Typography - Soft, Soothing & Gentle (Non-glaring, relaxing on eyes) */
    foreground:          #CBCDD6;                  /* Soft Warm Pearl (Gentle & Calm) */
    foreground-muted:    #888A96;                  /* Soft Slate Gray */
    foreground-dim:      #60626E;                  /* Subtle Dim Text */

    /* Gentle Frosted Selection Capsule (Whisper-soft highlight, no white flash) */
    selected:            rgba(255, 255, 255, 0.12); /* Soft Luminous Frosted Highlight */
    selected-text:       #EAEAEF;                  /* Pearl White Text on Selection */
    selected-alt:        rgba(255, 255, 255, 0.07); /* Secondary Subtle Highlight */

    /* Accents (Gentle, elegant, neutral) */
    accent:              #C4C6D0;                  /* Gentle Platinum Accent */
    accent-cyan:         #38BDF8;                  /* Soft Sky Glow */
    accent-amber:        #FBBF24;                  /* Warm Amber Warning */
    urgent:              #FB7185;                  /* Soft Rose Alert */

    /* Specular Hairline Glass Borders (Crisp definition over any wallpaper) */
    border-colour:       rgba(255, 255, 255, 0.11); /* Delicate Glass Hairline */
    border-subtle:       rgba(255, 255, 255, 0.05); /* Divider / Inner Border */
    border-highlight:    rgba(255, 255, 255, 0.20); /* Active Element Border */

    background-color:    transparent;
}
