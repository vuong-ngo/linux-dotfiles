{
  "$schema": "/etc/swaync/config.schema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "right",
  "control-center-positionY": "bottom",
  "control-center-width": 420,
  "control-center-height": 720,
  "control-center-margin-top": 0,
  "control-center-margin-right": 15,
  "control-center-margin-bottom": 15,
  "notification-window-width": 340,
  "notification-icon-size": 32,
  "transition-length": 250,
  "timeout": 3,
  "timeout-low": 2,
  "timeout-critical": 5,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "script-fail-notify": false,
  "widgets": [
    "title",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "󰂚 NOTIFICATION CENTER",
      "clear-all-button": true,
      "button-text": "󰎟 Clear All"
    },
    "dnd": {
      "text": "󰍶 Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰀝 Airplane",
          "type": "toggle",
          "command": "bash ~/.config/niri/scripts/airplane_mode.sh",
          "update-command": "sh -c 'nmcli radio wifi | grep -q \"disabled\" && echo true || echo false'",
          "interval": 10
        },
        {
          "label": "󰛨 Night Light",
          "type": "toggle",
          "command": "bash -c '~/.config/niri/scripts/night_light.sh'",
          "update-command": "pgrep -x wlsunset > /dev/null && echo true || echo false",
          "interval": 10
        },
        {
          "label": "󰌪 Power Saver",
          "type": "toggle",
          "command": "bash -c '~/.config/niri/scripts/power_saved.sh'",
          "update-command": "sh -c '[ -f /tmp/niri_power_save_active ] && echo true || echo false'",
          "interval": 10
        },
        {
          "label": "󰈈 Keep Awake",
          "type": "toggle",
          "command": "bash -c '~/.config/niri/scripts/keep_awake.sh'",
          "update-command": "sh -c '[ -f /tmp/keep_awake.lock ] && echo true || echo false'",
          "interval": 10
        }
      ]
    }
  },
  "scripts": {
    "notification-sound": {
      "exec": "bash ~/.config/swaync/scripts/notification_sound.sh",
      "run-on": "receive"
    }
  }
}
