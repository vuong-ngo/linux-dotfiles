# ============================================================
# Niri Utility Script Aliases (Fish Shell)
# Include in your ~/.config/fish/config.fish:
#   source ~/.config/niri/scripts/aliases.fish
# ============================================================

alias script-airplane="bash ~/.config/niri/scripts/airplane_mode.sh"
alias script-bright="bash ~/.config/niri/scripts/brightness.sh"
alias script-awake="bash ~/.config/niri/scripts/keep_awake.sh"
alias script-night="bash ~/.config/niri/scripts/night_light.sh"
alias script-power="bash ~/.config/niri/scripts/power_mode.sh"
alias script-powersave="bash ~/.config/niri/scripts/power_saved.sh"
alias script-nvidia="bash ~/.config/niri/scripts/rofi_nvidia.sh"
alias script-keybinds="bash ~/.config/niri/scripts/toggle_keybinds.sh"
alias script-volume="bash ~/.config/niri/scripts/volume.sh"
alias script-pin="bash ~/.config/niri/scripts/show_pin.sh"

# Rofi UI Scripts Shortcuts
alias script-wall="bash ~/.config/rofi/scripts/wallpaper-picker/wallpaper-picker.sh"
alias script-powermenu="bash ~/.config/rofi/scripts/power-menu/power-menu.sh"
alias script-clip="bash ~/.config/rofi/scripts/clipboard-manager/clipboard-manager.sh"

# Terminal Utilities
alias ssh="TERM=xterm-256color ssh"
