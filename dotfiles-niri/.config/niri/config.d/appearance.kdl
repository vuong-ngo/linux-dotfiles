// ================================================

// =====================================
// OVERVIEW SETTINGS
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Overview.html

overview {
    zoom 0.6
    backdrop-color "rgba(18, 18, 20, 0.90)"
    workspace-shadow { off; }
}

// =====================================
// LAYOUT SETTINGS GLOBAL
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Layout.html

layout {
    gaps 10
    center-focused-column "never"
    empty-workspace-above-first
    background-color "transparent"

    // Default column and window proportions
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    default-column-width {
        proportion 1.0;
    }

    // Shader
    shadow { off; }
    focus-ring { off; }
    border { off; }

    insert-hint {
        on
        color "rgba(255, 255, 255, 0.35)"
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// =====================================
// WINDOW TAB & RECENT WINDOWS STYLE
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Recent-Windows.html

recent-windows {
    on
    debounce-ms 200
    open-delay-ms 150

    highlight {
        active-color "#ffffffaa"
        urgent-color "#ffffffff"
        padding 10
        corner-radius 12
    }

    previews {
        max-height 400
        max-scale 0.5
    }
}

// =====================================
// WINDOW RULES
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Window-Rules.html

// Global window geometry & styling (14px rounded corners, crisp and lightweight)
window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    draw-border-with-background true
    tiled-state true
    scroll-factor 0.75
}

// Picture-in-Picture
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"app.zen_browser.zen$"# title="^Picture-in-Picture$"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"

    open-floating true
}

// Small utilities & dialogs
window-rule {
    match app-id="pop-id"
    match app-id="bubble"
    match app-id="task_dialog"
    match app-id="Preferences"
    match app-id="dialog"
    match app-id="menu"
    match app-id="Organizer"
    match app-id="About"
    match app-id="toolbox"
    match app-id="page-info"
    match app-id="webconsole"
    match app-id="Authy"
    match title="wants to save$"
    match title="wants to open$"
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    match title=r#".*(Open|Save|Select).*"#
    match title=r#".*Sign in - Google Accounts — Mozilla Firefox"#

    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id="gnome-calculator"
    match app-id="org.gnome.Calculator"

    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id="Nautilus"
    match app-id="org.gnome.Nautilus"
    match app-id="Snapshot"
    match app-id="org.gnome.Snapshot"
    match app-id="pavucontrol"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="nm-connection-editor"
    match app-id="blueman-manager"
    match app-id="wdisplays"
    match app-id="nwg-look"
    match app-id=r#"org\.gtk\.FileChooserDialog"#

    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.6; }
}

window-rule {
    match app-id="^jetbrains-.*"
    match app-id=r#"steam"# title=r#".*(Friends|Settings|Properties).*"#

    open-floating true
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="^steam_app_"
    match title=".exe$"

    variable-refresh-rate true
}

// Indicate screencasted windows with subtle highlight
window-rule {
    match is-window-cast-target=true

    focus-ring { off; }
    border { off; }
    shadow { off; }

    tab-indicator {
        active-color "#ffffff"
        inactive-color "#262626"
    }
}

// =====================================
// LAYER RULES
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Layer-Rules.html

layer-rule {
    geometry-corner-radius 14
    popups {
        geometry-corner-radius 10
    }
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

layer-rule {
    match namespace="waybar"
    match namespace="^swaync-control-center$"

    match at-startup=true
    place-within-backdrop true
}

layer-rule {
    match namespace="^launcher$"
    shadow { off; }
}

// Put swaybg inside the overview backdrop
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
