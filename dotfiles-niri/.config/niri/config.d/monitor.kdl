// =====================================
// OUTPUT CONFIGURATION
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Outputs.html

output "eDP-1" {
    scale 1.0
    transform "normal"
}

output "HDMI-A-1" {
    scale 1.0
    transform "normal"
}

output "DP-1" {
    scale 1.0
    transform "normal"
}

output "DP-2" {
    scale 1.0
    transform "normal"
}
