// =====================================
// INPUT CONFIGURATION
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Input.html

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 35
    }

    touchpad {
        tap
        drag false
        dwt
        accel-speed 0.25
        accel-profile "flat"

        scroll-method "two-finger"
        scroll-factor 1.0
        natural-scroll
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"

        scroll-factor 1.0
    }

    trackpoint {
        accel-speed 0.1
        accel-profile "flat"
    }
}

cursor {
    xcursor-size 24
}
