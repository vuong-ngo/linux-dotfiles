// =====================================
// ENVIRONMENTS
// =====================================
// https://niri-wm.github.io/niri/Configuration%3A-Miscellaneous.html

environment {
    // ============ XDG DESKTOP INTEGRATION ============
    // Critical for Screen Sharing & Portal functionality
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"

    // Fix for Electron apps (Discord, VS Code, Obsidian)
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // ============ TOOLKIT BACKENDS ============
    // Force applications to use Wayland natively
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_AWT_WM_NONREPARENTING "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"

    GDK_BACKEND "wayland,x11"
    GDK_SCALE "1"
    SDL_VIDEODRIVER "wayland,x11"
    CLUTTER_BACKEND "wayland"

    // ============ HYBRID GRAPHICS (INTEL iGPU + NVIDIA GTX 1650) ============
    // eDP-1 runs on Intel TigerLake iGPU; discrete NVIDIA runs on-demand via prime-run.
    // DO NOT set GBM_BACKEND="nvidia-drm" or __GLX_VENDOR_LIBRARY_NAME="nvidia" globally!
    // Forcing them breaks DMA-BUF buffer sharing with Intel compositor and causes severe browser flickering.
    // Intel Media Driver for native, power-efficient 4K/8K hardware video decode
    LIBVA_DRIVER_NAME "iHD"

    // ============ FCITX 5 ============
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "fcitx"

    // ============ JAVA & MISC ============
    _JAVA_AWT_WM_NONREPARENTING "1"
    _JAVA_OPTIONS "-Dsun.java2d.uiScale=1.0"
}
